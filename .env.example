# Copy to .env, replace every required blank, and keep .env out of git.
# Compose requires an immutable release digest; source builds ignore this.
KEYGATE_IMAGE=

# ─── Server ───────────────────────────────────────
PORT=9000
ENVIRONMENT=development
BASE_URL=http://localhost:9000
DATABASE_URL=postgres://keygate:keygate@localhost:5432/keygate?sslmode=disable
POSTGRES_PASSWORD=
REDIS_URL=

# ─── Required cryptographic material ─────────────
# Generate independent values; do not reuse secrets between environments.
JWT_SECRET=
LICENSE_SIGNING_KEY=
LICENSE_SIGNING_KEY_ID=development-2026-01
LICENSE_PREVIOUS_PUBLIC_KEY=
LICENSE_PREVIOUS_KEY_ID=
LICENSE_PREVIOUS_KEY_VALID_UNTIL=
# Blank defaults to BASE_URL.
LICENSE_TOKEN_ISSUER=
LICENSE_TOKEN_POLICY_VERSION=1
RELEASE_KEY_ENCRYPTION_KEY=
RELEASE_KEY_ENCRYPTION_PREVIOUS_KEY=
OTP_PEPPER=
METRICS_TOKEN=

# ─── Offline license policy ──────────────────────
OFFLINE_TOKEN_TTL=24h
OFFLINE_GRACE_PERIOD=0s
OFFLINE_CLOCK_SKEW=2m

# ─── First-run bootstrap ─────────────────────────
# Enable only on a private listener, then disable and remove the secret.
SETUP_ENABLED=true
BOOTSTRAP_SECRET=

# ─── OTP / SMTP ──────────────────────────────────
# Production refuses OTP startup without SMTP. Codes are never logged.
OTP_ENABLED=false
OTP_OPEN_REGISTRATION=false
OTP_ALLOWED_DOMAINS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# ─── Payments ────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVEMODE=false

# ─── HTTP and abuse limits ───────────────────────
MAX_REQUEST_BODY_KB=1024
STRIPE_WEBHOOK_MAX_KB=256
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_HEADER_KB=32
RATE_LIMIT_API=60
RATE_LIMIT_ADMIN=120
RATE_LIMIT_AUTH=20
BF_MAX_FAILS=5
BF_LOCKOUT_SECONDS=30

# ─── Webhooks / quotas ───────────────────────────
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_RETRY_INTERVAL=30s
WEBHOOK_HTTP_TIMEOUT=10s
QUOTA_WARNING_THRESHOLD=0.8

# ─── Optional release artifact storage ───────────
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=false
STORAGE_UPLOAD_TTL=1h
STORAGE_DOWNLOAD_TTL=10m
MAX_RELEASE_SIGN_SIZE_MB=500

# Comma-separated emails to promote after the corresponding user exists.
ADMIN_EMAILS=
